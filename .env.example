# Shanmuga Priya Crackers Supabase
# Dashboard → Project Settings → API Keys → Publishable key (sb_publishable_…)
# Use the Project URL only — do NOT add /rest/v1 at the end
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# Optional — company SMTP is configured in Supabase Dashboard (see supabase/company-smtp-setup.sql)
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Canonical site URL (defaults to https://www.shanmugapriyacrackers.com in siteConfig.ts)
# VITE_SITE_URL=https://www.shanmugapriyacrackers.com

# Optional — Google Search Console site verification meta tag content
# VITE_GOOGLE_SITE_VERIFICATION=your-verification-code-here

# Server-only (Vercel → Environment Variables). Live Google reviews on the home page.
# Home page Google reviews — browser key (HTTP referrers: http://localhost:5173/* + your domain)
# Enable in Google Cloud + link billing:
# - Maps JavaScript API
# - Places API (New)
# - Places API (legacy): https://console.cloud.google.com/apis/library/places-backend.googleapis.com
# VITE_GOOGLE_MAPS_API_KEY=
# Optional server fallback:
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=ChIJowo0h1szATsRVF3rsnB-8mg
# Optional — defaults to CID from https://maps.app.goo.gl/qXnU2NoDvUKoYvXT7
# GOOGLE_PLACE_CID=7562245746811690324

# Database migrations (npm run db:migrate)
# SUPABASE_DB_PASSWORD=

VITE_CHATBOT_ENABLED=false
